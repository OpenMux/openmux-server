<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="omx-base-path" content="{{ base_path }}" />
    <title>{% block title %}{{ title }}{% endblock %}</title>
    <link rel="stylesheet" href="{{ base_path }}/static/web_console.css" />
    <script src="{{ base_path }}/static/js/theme-init.js"></script>
    {% block head_extras %}{% endblock %}
  </head>
  <body class="{% block body_class %}{% endblock %}">
    {% set nav_ports = sidebar_ports if (sidebar_ports is defined and sidebar_ports) else ports %}
    <div class="app-layout">
      <aside class="sidebar{% if embed %} collapsed{% endif %}" id="sidebar">
        <div class="sidebar-header">
          <div class="brand">
            {% if logo_url %}
              <img class="logo-img" src="{{ base_path }}{{ logo_url }}" alt="logo" />
            {% else %}
              <div class="logo">{{ (realm.split()[0][0] ~ (realm.split()[1][0] if realm.split()|length > 1 else '')) | upper }}</div>
            {% endif %}
            <div class="brand-text">
              <span class="title">OpenMux</span> <span class="subtitle">Web Console</span>
            </div>
          </div>
        </div>
        <!-- Pinned top: System Status + any non-config-editor plugin links -->
        <div class="sidebar-static">
          <a class="nav-item {% if active_page == 'status' %}active{% endif %}" href="{{ base_path }}/">
            <span class="icon">🏠</span> System Status
          </a>
          {% if plugin_nav and plugin_nav|length > 0 %}
            {% for item in plugin_nav %}
              {% set required = item.require %}
              {% if not required or required == user_permission %}
                {% if item.path != '/config-editor' %}
                  <a class="nav-item {% if active_page == item.path %}active{% endif %}" href="{{ base_path }}{{ item.path }}">
                    <span class="icon">🔌</span> {{ item.title }}
                  </a>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
        <!-- Console: fills remaining space; port list scrolls within -->
        <div class="sidebar-console-area">
          <div class="nav-item-row">
            <a class="nav-item {% if active_page == 'console' %}active{% endif %}" href="{{ base_path }}/console" onclick="onConsoleNavClick(event)">
              <span class="icon">💻</span> Console
            </a>
            <button class="nav-expand" id="console-expand-btn" onclick="toggleConsolePorts(event)" title="Show ports">+</button>
          </div>
          <div class="nav-sub" id="console-ports" style="display:none">
            {% if nav_ports %}
              {% for p in nav_ports %}
                <a class="nav-sub-item {% if current_port == p.name %}active{% endif %}" href="{{ base_path }}/console?port={{ p.name }}">{{ p.name }}</a>
              {% endfor %}
            {% else %}
              <div class="nav-sub-empty">No ports</div>
            {% endif %}
          </div>
        </div>
        <!-- Config editor: pinned above footer, admin-only, expands upward -->
        {% if plugin_nav and plugin_nav|length > 0 %}
          {% for item in plugin_nav %}
            {% if item.path == '/config-editor' %}
              {% set required = item.require %}
              {% if not required or required == user_permission %}
                <div class="sidebar-config-area">
                  <div class="nav-group">
                    <div class="nav-item-row">
                      <a class="nav-item {% if active_page == item.path %}active{% endif %}" href="#" onclick="toggleConfigMenu(event)" id="nav-config-parent">
                        <span class="icon">⚙️</span> {{ item.title }}
                      </a>
                      <button class="nav-expand" id="config-expand-btn" onclick="toggleConfigMenu(event)">+</button>
                    </div>
                    <div class="nav-sub" id="config-menu" style="display:none">
                      <a class="nav-sub-item" href="{{ base_path }}{{ item.path }}?view=ports" id="nav-config-ports">Ports</a>
                      <a class="nav-sub-item" href="{{ base_path }}{{ item.path }}?view=listeners" id="nav-config-listeners">Listeners</a>
                      <a class="nav-sub-item" href="{{ base_path }}{{ item.path }}?view=muxcon" id="nav-config-muxcon">Muxcon</a>
                      <a class="nav-sub-item" href="{{ base_path }}{{ item.path }}?view=auth" id="nav-config-auth">Authentication</a>
                      <a class="nav-sub-item" href="{{ base_path }}{{ item.path }}?view=server" id="nav-config-setup">Server</a>
                      <a class="nav-sub-item" href="{{ base_path }}{{ item.path }}?view=reload" id="nav-config-reload">Reload</a>
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endif %}
        <div class="sidebar-footer">
          <button class="nav-item" id="themeToggle" title="Toggle Theme" style="width:100%; background:none; border:none; cursor:pointer; text-align:left; font:inherit; margin-bottom: 4px;">
            <span class="icon" id="themeIcon">☀️</span> <span id="themeText">Light Mode</span>
          </button>
          <a class="nav-item" href="{{ base_path }}/logout" title="Sign out">
            <span class="icon">🚪</span> Logout
          </a>
        </div>
      </aside>
      <div class="main-content">
        <header class="site">
          <button class="sidebar-toggle" id="sidebarToggle" title="Toggle Menu">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
          </button>
          <div class="page">{% block page_title %}{% endblock %}</div>
          {% block page_subtitle %}{% endblock %}
          <div class="{% block actions_class %}actions{% endblock %}">
            {% block header_actions %}{% endblock %}
          </div>
        </header>
        {% block content_wrapper %}
        <main class="{% block main_class %}{% endblock %}">
          {% block content %}{% endblock %}
        </main>
        {% endblock %}
      </div>
    </div>
    <script src="{{ base_path }}/static/js/layout.js"></script>
    {% block scripts %}{% endblock %}
  </body>
</html>
