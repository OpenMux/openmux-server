{% extends "layout.html.j2" %}

{% set active_page = 'status' %}

{% block page_title %}Status{% endblock %}

{% block header_actions %}
  <div class="extras">
    {% if server_version %}
      <span class="muted" title="OpenMux server version">OpenMux v{{ server_version }}{% if server_uptime %} · up {{ server_uptime }}{% endif %}</span>
    {% endif %}
  </div>
{% endblock %}

{% block content %}
  {# All page body markup lives in status_content.html.j2 so the same markup
     renders server-side here and as HTML fragments for the live update path
     (issue #85: GET /api/status/fragments + /ws/status). The header, MOTD
     card, and sort links are not live regions: they update on full loads.
     The page is always live (like the Power pages): status.js opens
     /ws/status on load and swaps the marked regions in place; no
     window.location.reload() is used and there is no toggle (issue #86). #}
  {% include "status_content.html.j2" %}
{% endblock %}

{% block scripts %}
  <script src="{{ base_path }}/static/js/status.js"></script>
{% endblock %}
