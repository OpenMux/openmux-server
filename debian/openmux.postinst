#!/bin/sh
set -e

if ! getent group openmux >/dev/null 2>&1; then
	addgroup --system openmux
fi

if ! getent passwd openmux >/dev/null 2>&1; then
	adduser --system \
		--ingroup openmux \
		--home /var/lib/openmux \
		--no-create-home \
		--shell /usr/sbin/nologin \
		--gecos "OpenMux service user" \
		openmux
fi

if getent group dialout >/dev/null 2>&1; then
	adduser openmux dialout >/dev/null 2>&1 || true
fi

install -d -o openmux -g openmux /var/lib/openmux /var/log/openmux

# Writable home for user port-action scripts. The default conffile points
# port_actions.actions_dir at it; the Config Editor creates action
# directories in the same place. 0750: owner (openmux) manages the files,
# group (openmux) can list, others cannot traverse.
install -d -m 0750 -o openmux -g openmux /etc/openmux/actions

# Fresh install: seed the bundled example scripts, so the action grants in the
# default server.yaml resolve and the Actions menu works out of the box. Never
# overwrite an existing file: an admin edit survives a reinstall or upgrade.
for script in /usr/share/openmux/action-examples/*.py; do
	[ -f "$script" ] || continue
	target="/etc/openmux/actions/$(basename "$script")"
	if [ ! -e "$target" ]; then
		install -m 0640 -o openmux -g openmux "$script" "$target"
	fi
done

install -d -m 0750 -o root -g openmux /etc/openmux

for cfg in authentication.yaml client.yaml security.yaml server.yaml; do
	default_cfg="/usr/share/openmux/default-config/$cfg"
	target_cfg="/etc/openmux/$cfg"
	if [ -f "$default_cfg" ] && [ ! -e "$target_cfg" ]; then
		if [ "$cfg" = "authentication.yaml" ]; then
			# Fresh install: replace the CHANGE_ME_ON_FIRST_BOOT sentinel with a
			# per-install random admin password. The plaintext is stored once in
			# /etc/openmux/.initial_credentials (0600) and printed on the console.
			# The name must match the file debian/openmux.install ships.
			gen_script=/usr/share/openmux/generate_deb_auth_config.py
			genpw=$(python3 "$gen_script" \
			--template "$default_cfg" \
			--output "$target_cfg" \
			--credentials-out /etc/openmux/.initial_credentials) || {
				echo "postinst: ERROR: could not generate the per-install admin password." >&2
				echo "postinst: The install is left in a failed state. Repair it as root:" >&2
				echo "postinst:   dpkg --configure openmux" >&2
				echo "postinst: or re-run manually:" >&2
				echo "postinst:   python3 $gen_script --template $default_cfg --output $target_cfg --credentials-out /etc/openmux/.initial_credentials" >&2
				exit 1
			}
			chown root:openmux /etc/openmux/.initial_credentials || true
			chmod 0600 /etc/openmux/.initial_credentials
			echo "OpenMux: generated per-install admin password (see /etc/openmux/.initial_credentials):" >&2
			echo "  $genpw" >&2
		else
			cp "$default_cfg" "$target_cfg"
		fi
	fi
	# Ownership the service needs, applied on every configure so an upgrade also
	# repairs a host that installed a package with the old root-owned layout.
	# The Config Editor runs as the service user, and its Save writes
	# server.yaml and authentication.yaml through ConfigManager.save_config, so
	# those two belong to openmux. security.yaml and client.yaml stay root owned:
	# the server only reads them, and root ownership keeps a running server from
	# widening its own security policy. 0640 both ways: owner writes, group reads,
	# others nothing. /etc/openmux itself stays 0750 root:openmux below, so the
	# service can read the directory but cannot add or replace a file in it; the
	# pre-save copies of the two writable files go to the state dir
	# (/var/lib/openmux/config-backups).
	if [ -e "$target_cfg" ]; then
		case "$cfg" in
		server.yaml | authentication.yaml)
			chown openmux:openmux "$target_cfg" || true
			;;
		*)
			chown root:openmux "$target_cfg" || true
			;;
		esac
		chmod 0640 "$target_cfg" || true
	fi
done

# The service must not create files here (see the ownership note above): it
# rewrites the two files it owns in place, and its config backups live under
# $STATE_DIRECTORY.
chmod 0750 /etc/openmux || true

#DEBHELPER#