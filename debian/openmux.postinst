#!/bin/sh
set -e

if ! getent group openmux >/dev/null 2>&1; then
	addgroup --system openmux
fi

if ! getent passwd openmux >/dev/null 2>&1; then
	adduser --system \
		--ingroup openmux \
		--home /var/lib/openmux \
		--no-create-home \
		--shell /usr/sbin/nologin \
		--gecos "OpenMux service user" \
		openmux
fi

if getent group dialout >/dev/null 2>&1; then
	adduser openmux dialout >/dev/null 2>&1 || true
fi

install -d -o openmux -g openmux /var/lib/openmux /var/log/openmux

# Writable home for user port-action scripts. The default conffile points
# port_actions.actions_dir at it; the Config Editor creates action
# directories in the same place. 0750: owner (openmux) manages the files,
# group (openmux) can list, others cannot traverse.
install -d -m 0750 -o openmux -g openmux /etc/openmux/actions

install -d -m 0750 -o root -g openmux /etc/openmux

for cfg in authentication.yaml client.yaml security.yaml server.yaml; do
	default_cfg="/usr/share/openmux/default-config/$cfg"
	target_cfg="/etc/openmux/$cfg"
	if [ -f "$default_cfg" ] && [ ! -e "$target_cfg" ]; then
		if [ "$cfg" = "authentication.yaml" ]; then
			# Fresh install: replace the CHANGE_ME_ON_FIRST_BOOT sentinel with a
			# per-install random admin password. The plaintext is stored once in
			# /etc/openmux/.initial_credentials (0600) and printed on the console.
			genpw=$(python3 /usr/share/openmux/generate-auth-config.py \
			--template "$default_cfg" \
			--output "$target_cfg" \
			--credentials-out /etc/openmux/.initial_credentials) || {
				echo "postinst: ERROR: could not generate the per-install admin password." >&2
				echo "postinst: The install is left in a failed state. Repair it as root:" >&2
				echo "postinst:   dpkg --configure openmux" >&2
				echo "postinst: or re-run manually:" >&2
				echo "postinst:   python3 /usr/share/openmux/generate-auth-config.py --template $default_cfg --output $target_cfg --credentials-out /etc/openmux/.initial_credentials" >&2
				exit 1
			}
			chown root:openmux /etc/openmux/.initial_credentials || true
			chmod 0600 /etc/openmux/.initial_credentials
			echo "OpenMux: generated per-install admin password (see /etc/openmux/.initial_credentials):" >&2
			echo "  $genpw" >&2
		else
			cp "$default_cfg" "$target_cfg"
		fi
	fi
	if [ -e "$target_cfg" ]; then
		chown root:openmux "$target_cfg" || true
		chmod 0640 "$target_cfg" || true
	fi
done

chmod 0750 /etc/openmux || true

#DEBHELPER#